{
  "manifest_version": 3,
  "name": "BC Tracker",
  "version": "1.0.0",
  "description": "Start and stop the BC Tracker timer from any Basecamp task.",
  "host_permissions": ["http://127.0.0.1:47823/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://app.basecamp.com/*", "https://3.basecamp.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
